{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Data Source=/data/filmes.db"
  },
  "MediaPath": "/media",
  "MaxConcurrentTranscodeJobs": 2,
  "HlsCacheMaxGB": 20,
  "HlsMaxAlturaReencode": 1080,
  "HlsRkmppDecodeHw": true,
  "HlsOrphanTimeoutSeconds": 90,
  "AberturaMinimoSegundos": 10,
  "AberturaMinimoPuloSegundos": 4,
  "AberturaUsarCapitulos": true,
  "ThermalPauseCelsius": 62,
  "TmdbApiKey": "",
  "AllowedHosts": "*"
}
