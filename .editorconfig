root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4
max_line_length = 140

# namespaces em uma linha só (o código já é assim)
csharp_style_namespace_declarations = file_scoped:warning

# usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_using_directive_placement = outside_namespace:warning

# var quando o tipo é óbvio
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:silent

# expressões modernas
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion

# "unused using" vira aviso (pega no dotnet format / CI)
dotnet_diagnostic.IDE0005.severity = warning

# Teto de tamanho/complexidade — os arquivos gigantes não voltam sem alguém perceber.
# CA1502 complexidade ciclomática (padrão 25), CA1505 índice de manutenibilidade (padrão 10),
# CA1506 acoplamento de classes (padrão 95 pra tipo / 40 pra método).
dotnet_diagnostic.CA1502.severity = warning
dotnet_diagnostic.CA1505.severity = warning
dotnet_diagnostic.CA1506.severity = warning

# Program.cs é a raiz de composição (registra todos os serviços): acoplamento alto é o trabalho dele.
[Program.cs]
dotnet_diagnostic.CA1506.severity = none

[*.{json,yml,yaml,csproj,props,targets}]
indent_size = 2

[*.{html,css,js}]
indent_size = 2
max_line_length = off

[*.md]
trim_trailing_whitespace = false
